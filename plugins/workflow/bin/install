#!/usr/bin/env bash
# install: symlink the fleet's scripts (sync, runner) into ~/.local/bin, so they
# run from any repo. Rerun after adding a script; a missing one is skipped.
set -euo pipefail

here=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)
target=$HOME/.local/bin
mkdir -p "$target"

for name in sync runner; do
  [ -f "$here/$name" ] || continue
  link=$target/$name
  if [ -e "$link" ] && [ ! -L "$link" ]; then
    echo "install: $link exists and is not a symlink; move it away first" >&2
    exit 1
  fi
  ln -sfn "$here/$name" "$link"
  echo "install: $link -> $here/$name"
done

case ":$PATH:" in *":$target:"*) ;; *) echo "install: add $target to your PATH" ;; esac
